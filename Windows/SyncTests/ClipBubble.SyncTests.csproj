<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sync engine, codec and store on .NET 10, so they run on the Mac and Linux too, against the Swift engine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ClipBubble</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Sources\Sync.cs;..\Sources\Link.cs;..\Sources\Store.cs;..\Sources\Qr.cs;..\Sources\Pairing.cs;*.cs" />
  </ItemGroup>
</Project>
